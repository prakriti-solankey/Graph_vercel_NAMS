# ─────────────────────────────────────────────────────────────
#  Copy this file to .env, then fill in the REQUIRED block.
#      cp .env.example .env
#      npm run check
# ─────────────────────────────────────────────────────────────

# Quick start (no persistent memory):
#   OPENAI_API_KEY=sk-proj_replace-with-your-key
#   MEMORY_MODE=off
#
# Memory example (choose provider, middleware, or mcp):
#   OPENAI_API_KEY=sk-proj_replace-with-your-key
#   MEMORY_MODE=provider
#   MEMORY_API_KEY=nams_replace-with-your-key
#   WORKSPACE_ID=your-name-or-student-id
#
# Never commit .env or paste real keys into this file.


# ── REQUIRED ─────────────────────────────────────────────────

# Lets the agent think.
#   Get one: create or sign in to an OpenAI Platform account, then open
#   https://platform.openai.com/api-keys and select "Create new secret key".
#   Example: sk-proj-AbC123...
OPENAI_API_KEY=

# Which memory integration is live. This is the workshop's switch.
#   off         no memory — start here, watch it forget you
#   provider    createNamsProvider() — memory the model can't see
#   middleware  createNams().wrap()  — same, wrapping one model
#   mcp         the hosted MCP server — the model decides
MEMORY_MODE=off

# Lets the agent remember. Only used when MEMORY_MODE is not "off".
#   Get one: create or sign in to a free Neo4j Agent Memory account at
#   https://memory.neo4jlabs.com, then create an API key in its dashboard.
#   Example: nams_1a2b3c4d5e6f...
MEMORY_API_KEY=

# Whose memory this is. Only used when MEMORY_MODE is not "off".
# Put your OWN name here so you don't share a brain with the
# person sitting next to you.
#   Example: ananya
WORKSPACE_ID=


# ── OPTIONAL ─────────────────────────────────────────────────
# Everything below has a working default. Leave blank to use it.

# Use Vercel AI Gateway instead of OpenAI directly. One key reaches
# OpenAI, Anthropic, Google and others.
#   Get one: sign in to Vercel, select a team, then open
#   https://vercel.com/dashboard → AI Gateway → API Keys.
#   Example: vck_AbC123...
AI_GATEWAY_API_KEY=

# Force which route the model takes. Blank = auto: OpenAI wins when
# OPENAI_API_KEY is set and no gateway credential is present.
#   Values:  openai | gateway | openai-compatible
MODEL_ROUTING=

# ── Open-source / OpenAI-compatible providers ──────────────
# Use any provider that speaks the OpenAI API (Groq, Ollama, Moonshot/Kimi,
# Together, Fireworks, LiteLLM, …) without going through Vercel Gateway.
# Set MODEL_ROUTING=openai-compatible (or just set the URL — it auto-detects).
#   Example (Kimi):    OPENAI_COMPATIBLE_BASE_URL=https://api.moonshot.cn/v1
#                      OPENAI_COMPATIBLE_API_KEY=sk-...   AGENT_MODEL=kimi-k2
#   Example (Groq):    OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
#                      OPENAI_COMPATIBLE_API_KEY=gsk_...  AGENT_MODEL=llama-3.3-70b-versatile
#   Example (Ollama):  OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
#                      (no key needed)                    AGENT_MODEL=llama3.2
#   Example (LiteLLM): OPENAI_COMPATIBLE_BASE_URL=http://localhost:4000
#                      OPENAI_COMPATIBLE_API_KEY=<litellm-master-key>
#                      AGENT_MODEL=<any model name configured in LiteLLM>
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Which model answers.
#   Default: openai/gpt-5.4-mini
#   Example: anthropic/claude-sonnet-5   (needs the gateway route)
#   Example: moonshotai/kimi-k2          (open-source, needs the gateway route)
AGENT_MODEL=

# That model's context window, in tokens. eve uses it to decide when
# to compact a long conversation. Lower it for a smaller model.
#   Default: 400000
AGENT_MODEL_CONTEXT_TOKENS=

# Point at your own NAMS server instead of the hosted one.
#   Default: https://memory.neo4jlabs.com/v1
#   Set this only when your NAMS administrator gives you a self-hosted API URL.
#   Example: https://nams.example.com/v1
MEMORY_ENDPOINT=

# Point at your own NAMS MCP server. Used only when MEMORY_MODE=mcp.
#   Default: https://memory.neo4jlabs.com/mcp
#   Set this only when your NAMS administrator gives you a self-hosted MCP URL.
#   Example: https://nams.example.com/mcp
MEMORY_MCP_URL=
